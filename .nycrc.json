{
    "all": true,
    "include": [
        "packages/*/src/**/*.js",
        "packages/*/src/**/*.jsx",
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx"
    ],
    "exclude": [
        "**/*.stories.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
    ],
    "report-dir": "coverage/cypress",
    "temp-dir": ".nyc_output"
}
