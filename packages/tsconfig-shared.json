// This file is used by the tsconfig-build.json files in each package.
/* Visit https://aka.ms/tsconfig to read more about this file */
{
    // Paths in this file resolve relative to THIS file, not to any file that
    // extends it, so a bare "dist" would mean `packages/dist` and match
    // nothing. Every pattern in this list needs the `**/` prefix to reach each
    // package's own directory.
    "exclude": [
        "**/dist",
        "**/*.test.*",
        "**/__tests__/**",
        "**/*.testdata.*",
        "**/__testdata__/**",
        "**/__testutils__/**",
        "**/*.stories.*",
        "**/__stories__/**",
        "**/__docs__/**",
        "**/*.cypress.*"
    ],
    "extends": "../tsconfig-common.json",
    "compilerOptions": {
        "composite": true,
        "incremental": true, // Required for composite projects

        // We use rollup + swc to compile our bundles so we
        // only need tsc to output .d.ts files
        "declaration": true,
        "emitDeclarationOnly": true,

        "paths": {
            "@khanacademy/*": [
                "./*/src"
            ]
        },
    },
}
