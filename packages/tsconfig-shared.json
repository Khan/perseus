// This file is used by the tsconfig-build.json files in each package.
/* Visit https://aka.ms/tsconfig to read more about this file */
{
    "exclude": [
        "dist",
        "**/*.test.*",
        "**/__tests__/**",
        "**/*.testdata.*",
        "**/__testdata__/**",
        "**/__testutils__/**",
        "**/*.stories.*",
        "**/__stories__/**",
        "**/__docs__/**",
        "**/*.cypress.*",
        // perseus-core's item-splitting entry point exists only for the
        // `check_item_splitting` job in
        // .github/workflows/pr-comparison-checks.yml, which esbuilds it from
        // source and diffs the bundle between the base branch and the PR to
        // flag unintended changes. It is not a published entry point, so a
        // declaration for it would ship a file nothing can import. It stays
        // type-checked via the root tsconfig.json, which `pnpm typecheck`
        // uses; only the build configs that extend this file skip it.
        "**/index.item-splitting.ts"
    ],
    "extends": "../tsconfig-common.json",
    "compilerOptions": {
        "composite": true,
        "incremental": true, // Required for composite projects

        // We use rollup + swc to compile our bundles so we
        // only need tsc to output .d.ts files
        "declaration": true,
        "emitDeclarationOnly": true,

        "paths": {
            "@khanacademy/*": [
                "./*/src"
            ]
        },
    },
}
