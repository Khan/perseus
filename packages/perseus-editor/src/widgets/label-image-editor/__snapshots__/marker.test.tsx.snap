                style="align-items: center; border-width: 0px; border-style: solid; box-sizing: border-box; display: flex; flex-direction: column; margin: 0px; padding: 0px; position: relative; z-index: 0; min-block-size: 0px; min-inline-size: auto; align-self: center; color: var(--wb-c-cell-accessoryLeft-color-default-foreground);"
              >
                <div
                  class="checkbox"
                  style="align-items: stretch; border-width: var(--wb-border-width-thin); border-style: solid; box-sizing: border-box; display: flex; flex-direction: column; margin: 0px; padding: 0px; position: relative; z-index: 0; min-block-size: var(--wb-sizing-size_160); min-inline-size: var(--wb-sizing-size_160); align-self: center; height: var(--wb-sizing-size_160); background: var(--wb-semanticColor-input-default-background); border-radius: 3px; border-color: var(--wb-semanticColor-input-default-border);"
                />
              </div>
              <div
                style="align-items: stretch; border-width: 0px; border-style: solid; box-sizing: border-box; display: flex; flex-direction: column; margin: 0px; padding: 0px; position: relative; z-index: 0; min-block-size: 0px; min-inline-size: 0px; align-self: center; flex: 1; overflow-wrap: break-word; gap: var(--wb-c-cell-root-layout-gap-detail);"
              >
                <div
                  style="-webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; display: block; font-family: var(--wb-font-family-sans); margin: 0px; font-size: var(--wb-font-body-size-medium); font-weight: var(--wb-c-dropdown-item-font-weight); line-height: var(--wb-sizing-size_200); white-space: nowrap; user-select: none; overflow: hidden; text-overflow: ellipsis;"
                >
                  Choice 2
                </div>
              </div>
            </button>
          </div>
          <hr
            style="height: 0px; margin: 0px; border: solid var(--wb-semanticColor-core-border-neutral-default); border-width: 0 0 1px; box-shadow: none;"
          />
          <button
            aria-disabled="false"
            data-kind="tertiary"
            data-style-active="background: var(--wb-semanticColor-action-tertiary-destructive-press-background); border-radius: var(--wb-c-button-root-border-radius-press); color: var(--wb-semanticColor-action-tertiary-destructive-press-foreground); border-color: var(--wb-semanticColor-action-tertiary-destructive-press-border); box-shadow: inset 0 0 0 var(--wb-c-button-root-border-width-tertiary-press) var(--wb-semanticColor-action-tertiary-destructive-press-border); text-underline-offset: var(--wb-c-button-root-font-offset-default); text-decoration: var(--wb-c-button-root-font-decoration-press) var(--wb-c-button-root-sizing-underline-press);"
            data-style-focus="-webkit-tap-highlight-color: rgba(0,0,0,0);"
            data-style-focus-visible="box-shadow: 0 0 0 var(--wb-border-width-medium) var(--wb-semanticColor-focus-inner); outline: var(--wb-border-width-medium) solid var(--wb-semanticColor-focus-outer); outline-offset: var(--wb-border-width-medium);"
            data-style-media-hover-hover-hover="background: var(--wb-semanticColor-action-tertiary-destructive-hover-background); border-radius: var(--wb-c-button-root-border-radius-hover); color: var(--wb-semanticColor-action-tertiary-destructive-hover-foreground); border-color: var(--wb-semanticColor-action-tertiary-destructive-hover-border); box-shadow: inset 0 0 0 var(--wb-c-button-root-border-width-tertiary-hover) var(--wb-semanticColor-action-tertiary-destructive-hover-border); text-underline-offset: var(--wb-c-button-root-font-offset-default); text-decoration: var(--wb-c-button-root-font-decoration-hover) var(--wb-c-button-root-sizing-underline-hover);"
            data-style-moz-focus-inner="border: 0px;"
            style="margin: 0px; position: relative; display: inline-flex; align-items: center; justify-content: center; padding: 0px; border: none; cursor: pointer; outline: none; text-decoration: none; box-sizing: border-box; touch-action: manipulation; user-select: none; height: var(--wb-c-button-root-sizing-height-medium); padding-block: 0px; border-radius: var(--wb-c-button-root-border-radius-default); padding-inline: var(--wb-c-button-root-layout-padding-inline-tertiary-medium); border-style: solid; border-width: var(--wb-c-button-root-border-width-tertiary-default); border-color: var(--wb-semanticColor-action-tertiary-destructive-default-border); background: var(--wb-semanticColor-action-tertiary-destructive-default-background); color: var(--wb-semanticColor-action-tertiary-destructive-default-foreground); transition: border-radius 0.1s ease-in-out;"
            type="button"
          >
            <span
              style="-webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; display: inline-block; font-family: var(--wb-font-family-sans); margin: 0px; font-size: var(--wb-font-body-size-medium); font-weight: var(--wb-c-button-root-font-weight-default); line-height: var(--wb-c-button-root-font-lineHeight-default); align-items: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; pointer-events: none;"
            >
              Delete marker
            </span>
          </button>
        </div>
      </div>
      <svg
        aria-hidden="true"
        fill="var(--wb-semanticColor-core-background-base-default)"
        height="20"
        style="position: absolute; pointer-events: none; top: 100%; filter: drop-shadow(0 4px 2px var(--wb-semanticColor-core-shadow-transparent-mid));"
        viewBox="0 0 20 20"
        width="22"
      >
        <path
          clip-path="url(#:rd:)"
          d="M0,0 H20 L10,10 Q10,10 10,10 Z"
          fill="none"
          stroke="var(--wb-semanticColor-core-border-neutral-subtle)"
          stroke-width="3"
        />
        <path
          d="M0,0 H20 L10,10 Q10,10 10,10 Z"
          stroke="var(--wb-semanticColor-core-background-base-default)"
        />
        <clippath
          id=":rd:"
        >
          <rect
            height="20"
            width="22"
            x="-1"
            y="1"
          />
        </clippath>
      </svg>
    </div>
    <span
      data-floating-ui-focus-guard=""
      data-type="inside"
      role="button"
      style="border: 0px; height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: fixed; white-space: nowrap; width: 1px; top: 0px; left: 0px;"
      tabindex="0"
    />
  </div>
</body>
`;
