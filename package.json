    "scripts": {
        "gen:parsers": "pnpm --filter ./packages/kas gen:parsers",
        "prebuild": "pnpm gen:parsers",
        "build": "config/build/build-packages.ts",
        "prebuild:docs": "pnpm clean:docs",
        "build:docs": "typedoc",
        "build:storybook": "storybook build --stats-json",
        "build:types": "tsc --build --force tsconfig-build.json",
        "build:prodsizecheck": "pnpm build --configEnvironment='production'",
        "watch": "pnpm build --watch",
        "clean": "./utils/clean.sh",
        "clean:docs": "git clean -fdx docs/ && git checkout HEAD -- docs/",
        "coverage": "./utils/test-with-coverage.sh",
        "fixc": "utils/changed-files.sh | utils/lint.sh --fix",
        "lint": "eslint . --ext .js --ext .jsx --ext .ts --ext .tsx --ext .mts --ext .cjs",
        "linc": "utils/changed-files.sh | utils/lint.sh",
        "lint:timing": "cross-env TIMING=1 pnpm lint",
        "pre-publish-check": "utils/pre-publish-check-ci.ts",
        "publish:ci": "pnpm pre-publish-check && git diff --stat --exit-code HEAD && pnpm build && pnpm build:types && changeset publish",
        "update-catalog-hashes": "utils/update-catalog-hashes-cli.ts",
        "test": "jest",
        "tesc": "utils/changed-files.sh | tr '\\n' '\\0' | xargs -r -0 pnpm jest --silent --findRelatedTests --passWithNoTests --",
        "storybook": "storybook dev -p 6006",
        "start": "pnpm storybook",
        "pw": "playwright test --config config/playwright/playwright.config.ts --ui",
        "pw:ci": "playwright test --config config/playwright/playwright.config.ts",
        "pw:gallery": "vite --config config/playwright/vite.config.mts",
        "pw:gallery:preview": "vite build --config config/playwright/vite.config.mts && vite preview --config config/playwright/vite.config.mts",
        "format": "prettier --write .",
        "tsc": "pnpm typecheck",
        "typecheck": "tsc",
        "knip": "./utils/knip.sh",
        "extract-css": "node ./utils/extract-css.js",
        "sync-legacy-styles": "node ./utils/sync-legacy-styles.js",
        "force-update": "touch package.json && pnpm i",
        "fi": "pnpm force-update"
    },
    "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11"
