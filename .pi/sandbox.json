{
    "enabled": true,
    "failClosed": true,
    "network": {
        "allowedDomains": [
            "localhost",
            "github.com",
            "api.github.com",
            "registry.npmjs.org",
            "npm.pkg.github.com",
            "download.cypress.io",
            "cdn.cypress.io"
        ],
        "deniedDomains": [],
        "allowLocalBinding": true
    },
    "filesystem": {
        "allowWrite": [
            ".",
            "/tmp",
            "/private/tmp",
            "~/.npm",
            "~/.local/share/mise",
            "~/.local/state/mise",
            "~/.cache/node/corepack",
            "~/Library/pnpm",
            "~/Library/Caches/pnpm"
        ],
        "denyRead": [
            ".env",
            "~/.ssh",
            "~/.aws",
            "~/.gnupg",
            "~/.netrc",
            "~/.config/ka-agent-gh-token",
            "~/.config/ka-olc",
            "~/.claude/.credentials.json",
            "~/.codex/auth.json",
            "~/.pi/agent/auth.json"
        ],
        "denyWrite": [
            ".claude",
            ".codex",
            ".cursor",
            ".opencode",
            ".pi",
            ".agents",
            ".git/hooks",
            ".git/config",
            "AGENTS.md",
            ".env",
            ".mcp.json",
            ".mcp",
            ".agent-settings-assets-manifest.json"
        ]
    },
    "excludedCommands": [
        "pbcopy"
    ]
}
