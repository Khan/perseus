{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "bracketSpacing": false,
    "printWidth": 80,
    "sortPackageJson": false,
    // The same groups as the `import/order` rule that ESLint enforced before
    // oxfmt took over import sorting. The order within a group can differ.
    // Only applies to JS and TS files.
    "sortImports": {
        "groups": [
            "builtin",
            "external",
            "internal",
            "parent",
            "sibling",
            "type",
        ],
    },
    // oxfmt also skips everything in .gitignore, so this list only needs
    // files that are checked in.
    "ignorePatterns": [
        // Generated
        "data/questions/**/*.json",
        "**/CHANGELOG.md",
        ".changeset/*.md",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "__genfiles__/",

        // Frozen parser regression fixtures. CI fails a PR that changes them
        // (see .github/workflows/protect-regression-data.yml), so a formatter
        // update must never touch them.
        "packages/perseus-core/src/parse-perseus-json/regression-tests/item-data/",
        "packages/perseus-core/src/parse-perseus-json/regression-tests/article-data/",
        "packages/perseus-core/src/parse-perseus-json/regression-tests/renderer-data/",
        "packages/perseus-core/src/parse-perseus-json/regression-tests/user-input-data/",

        // Third-party code and data
        "vendor/",
        "packages/perseus/src/jquery.mobile.vmouse.js",
        "packages/perseus-editor/src/katex-mhchem/",
        // Speech Rule Engine locale data, copied from the package for tests.
        "config/test/mathjax-sre/",

        // Generated by khan/agent-settings (see .gitattributes)
        ".claude/",
        ".codex/",
        ".cursor/",
        ".opencode/",
        ".pi/",
        ".github/workflows/validate-workflows.yml",
    ],
}
