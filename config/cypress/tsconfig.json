{
    // https://docs.cypress.io/guides/tooling/typescript-support#Configure-tsconfigjson
    "extends": "../../tsconfig-common.json",
    "compilerOptions": {
        "noEmit": true,
        // be explicit about types included
        // to avoid clashing with Jest types
        "types": [
            "cypress",
            "node",
            "cypress-real-events",
            "cypress-wait-until",
        ],
    },
    "include": [
        // All typescript files in _this_ directory
        "**/*.ts",
        "**/*.tsx",
        // All .cypress.tsx? files in any package
        "../../packages/**/*.cypress.ts",
        "../../packages/**/*.cypress.tsx",
        // Shared and package-specific ambient declarations
        "../../packages/perseus/src/testing/render-question-with-cypress.tsx",
        "../../types/**/*.d.ts",
        "../../packages/*/types/**/*.d.ts",
    ],
}
