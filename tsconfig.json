// This file is used by the `typecheck` command in package.json
/* Visit https://aka.ms/tsconfig to read more about this file */
{
    "exclude": [
        "**/dist",
        "coverage",
        "coverage-ts",

        // Cypress files - covered by config/cypress/tsconfig.json
        "cypress.config.mts",
        "config/cypress/**",
        "**/*.cypress.ts",
        "**/*.cypress.tsx",
        "packages/perseus/src/testing/render-question-with-cypress.tsx",
    ],
    "extends": "./tsconfig-common.json",
    "compilerOptions": {
        "noEmit": true,
        "paths": {
            "jsdiff": ["./vendor/jsdiff/jsdiff.js"],
            "raphael": ["./vendor/raphael/raphael.js"],
        },
        "plugins": [
            {
                "name": "typescript-plugin-css-modules",
                "options": {
                    "classnameTransform": "camelCase",
                    "goToDefinition": true,
                },
            },
        ],

        /* Preference */
        // If this is disabled, TS will sometimes just delete dead code, which
        // can be confusing!
        "allowUnreachableCode": true,
    },
}
