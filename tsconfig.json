// This file is used by the `typecheck` command in package.json
/* Visit https://aka.ms/tsconfig to read more about this file */
{
    // TypeScript's default `**/*` skips dot-directories, so `.storybook` has to
    // be named explicitly. Without it, `preview.tsx` -- which gates whether any
    // story renders at all -- is never type-checked.
    "include": ["**/*", ".storybook/**/*"],
    "exclude": [
        "**/dist",
        "coverage",
        "coverage-ts",
        "cypress.config.ts",
        "config/cypress/**",
        "config/build/**",
        "**/*.cypress.ts",
        "**/*.cypress.tsx"
    ],
    "extends": "./tsconfig-common.json",
    "compilerOptions": {
        "noEmit": true,
        "paths": {
            "jsdiff": ["./vendor/jsdiff/jsdiff.js"],
            "raphael": ["./vendor/raphael/raphael.js"]
        },
        "plugins": [
            {
                "name": "typescript-plugin-css-modules",
                "options": {
                    "classnameTransform": "camelCase",
                    "goToDefinition": true
                },
            }
        ],

        /* Preference */
        // If this is disabled, TS will sometimes just delete dead code, which
        // can be confusing!
        "allowUnreachableCode": true
    }
}
